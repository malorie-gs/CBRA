ossorigin="" href="https://chatgpt.com/cdn/assets/0f4877ff-mitqv10qxfhbdhly.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/181180d3-ftg9kg9007y14knb.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/20fadd5c-cbte1r5aamqi22di.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/20a8d32f-i913jclhn39dlvmm.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/99aa0965-htwzfk9xa604dyee.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/f1cb57e0-3l6qsm8ibgeb5eia.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/6fd89734-d4hne6iryvgfatt3.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/9cbd703c-cz3g0dyiw3pfj76x.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/3d671922-4u5lq1evnoelp56y.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/9cb51fe8-i5tng3qo981zzkg9.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/f945b658-bb47qipj8ionepub.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/e65c5909-n3j104vbmtullwwk.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/03cc85d7-f9ru9jigg8mrvmry.js"><link rel="stylesheet" crossorigin="" href="./cbra-icon_files/artifact-preview-sidebar-k26ypxwb.css"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/ce1c05a6-cfppsxtvjhp0g23g.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/1004941a-cac87ohmunvb65rp.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/a8af2dc6-et8f4cmf82qc4peq.js"><link rel="modulepreload" as="script" crossorigin="" href="https://chatgpt.com/cdn/assets/d02014d5-mytukl0455pabaoz.js"></head><body class="" style=""><span data-radix-focus-guard="" tabindex="0" style="outline: none; opacity: 0; position: fixed; pointer-events: none;"></span><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
