d-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col agent-turn"><div class="flex max-w-full flex-col gap-4 [&amp;&gt;div:has([data-free-thinking-preview-answer=true])+:is(.text-message,.relative:has(&gt;.text-message))]:-mt-2 grow"><div data-message-author-role="assistant" data-message-id="cdb12c69-0078-4d98-8c2b-ae0f8f822949" dir="auto" data-message-model-slug="gpt-5-6-mini" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden"><div class="LR5Y_W_content markdown prose dark:prose-invert wrap-break-word w-full dark markdown-new-styling"><p dir="auto" data-start="0" data-end="87">Ahh yes — <strong data-start="10" data-end="47">only the Case Information section</strong>, not every <code data-start="59" data-end="74">.case-details</code> on the site.</p>
<p dir="auto" data-start="89" data-end="206">Use this instead. It targets the section containing the case info specifically and leaves the rest of the site alone:</p>
<pre class="overflow-visible! px-0!" data-start="208" data-end="705"><div class="relative w-full mt-4 mb-1"><div class=""><div class="contents"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="relative h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback"><div class="select-none sticky z-2 top-(--sticky-padding-top)"><div class="flex w-full items-center justify-between py-1.5 ps-4 pe-1.5 font-sans md:ps-5 bg-(--code-block-surface)"><div class="flex max-w-[75%] min-w-0 cursor-default items-center text-sm font-medium justify-self-start text-token-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm me-2.5 shrink-0"><use href="/cdn/assets/sprites-core-07247886.svg#72c6a7" fill="currentColor"></use></svg>CSS</div><div class="flex flex-row items-center gap-0.5 justify-self-end"><button type="button" class="flex gap-1 items-center select-none py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-07247886.svg#7fccfb" fill="currentColor"></use></svg></button></div></div></div><div class="pointer-events-none absolute inset-x-4 top-12 bottom-4"><div class="pointer-events-none sticky z-40 shrink-0 z-1!" style="top: calc(calc(var(--sticky-padding-top) + 48px) - 1px * 3); margin-bottom: calc(-4px); height: calc(4px); mask-image: linear-gradient(transparent 25%, white 75%);"><div class="sticky bg-token-border-light" style="top: calc(var(--sticky-padding-top) + 48px); height: 1px;"></div></div></div><div class="relative"><div class="h-full min-h-0 min-w-0"><div class="h-full min-h-0 min-w-0" style="width: 100%; transform: none;"><div class=""><div class="relative"><div class="" style="transform: none;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼs ͼ16"><div class="cm-scroller"><pre class="cm-content q9tKkq_readonly m-0"><code><span class="ͼt">/* =========================================================
   CBRA — CASE INFORMATION ONLY
   ========================================================= */</span><span>

</span><span class="ͼv">#</span><span class="ͼ13">case-information</span><span> .</span><span class="ͼ10">case-details</span><span> {
    gap: </span><span class="ͼy">16</span><span class="ͼv">px</span><span> </span><span class="ͼy">20</span><span class="ͼv">px</span><span>;
}

</span><span class="ͼv">#</span><span class="ͼ13">case-information</span><span> .</span><span class="ͼ10">case-details</span><span> </span><span class="ͼv">&gt;</span><span> </span><span class="ͼ13">div</span><span> {
    padding: </span><span class="ͼy">18</span><span class="ͼv">px</span><span> </span><span class="ͼy">20</span><span class="ͼv">px</span><span>;
    min-height: </span><span class="ͼy">72</span><span class="ͼv">px</span><span>;
}

</span><span class="ͼv">#</span><span class="ͼ13">case-information</span><span> .</span><span class="ͼ10">case-details</span><span> </span><span class="ͼ13">strong</span><span> {
    display: </span><span class="ͼy">block</span><span>;
    margin-bottom: </span><span class="ͼy">8</span><span class="ͼv">px</span><span>;
}

</span><span class="ͼv">#</span><span class="ͼ13">case-information</span><span> .</span><span class="ͼ10">case-details</span><span> </span><span class="ͼ13">span</span><span> {
    display: </span><span class="ͼy">block</span><span>;
    line-height: </span><span class="ͼy">1.5</span><span>;
}</span></code></pre></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></div></div></div></pre>
<p dir="auto" data-start="707" data-end="824"><strong data-start="707" data-end="721">One thing:</strong> if your <code data-start="730" data-end="741">Case.html</code> does <strong data-start="747" data-end="754">not</strong> have <code data-start="760" data-end="783">id="case-information"</code> on that section, this won't do anything.</p>
