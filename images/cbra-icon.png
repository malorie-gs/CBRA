where] whitespace-pre-wrap">&lt;!DOCTYPE html&gt;

&lt;html lang="en"&gt;

&lt;head&gt;

&lt;meta charset="UTF-8"&gt;

&lt;meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
&gt;

&lt;title&gt;Case Archive | CBRA&lt;/title&gt;

&lt;link
    rel="stylesheet"
    href="css/style.css"
&gt;

&lt;/head&gt;

&lt;body&gt;

&lt;header&gt;

    &lt;h1&gt;
        Criminal Behavior Research Archive
    &lt;/h1&gt;

    &lt;p&gt;
        An open research resource for the study of crime, psychology, and human behavior.
    &lt;/p&gt;

    &lt;nav&gt;

        &lt;a href="index.html"&gt;
            Home
        &lt;/a&gt;

        &lt;a href="archive.html"&gt;
            Case Archive
        &lt;/a&gt;

    &lt;/nav&gt;

&lt;/header&gt;


&lt;main class="case-page"&gt;


    &lt;!-- =========================================
         CASE HEADER
         ========================================= --&gt;

    &lt;section class="case-header"&gt;

        &lt;h2 id="case-name"&gt;
            Loading case...
        &lt;/h2&gt;

        &lt;p id="case-location"&gt;
            —
        &lt;/p&gt;

        &lt;p id="case-date-header"&gt;
            —
        &lt;/p&gt;

    &lt;/section&gt;



    &lt;!-- =========================================
         CASE INFORMATION
         ========================================= --&gt;

    &lt;section class="case-section"&gt;

        &lt;h2&gt;
            Case Information
        &lt;/h2&gt;


        &lt;div class="case-information-grid"&gt;


            &lt;div&gt;

                &lt;strong&gt;
                    Date
                &lt;/strong&gt;

                &lt;span id="case-date"&gt;
                    —
                &lt;/span&gt;

            &lt;/div&gt;


            &lt;div&gt;

                &lt;strong&gt;
                    Country
                &lt;/strong&gt;

                &lt;span id="case-country"&gt;
                    —
                &lt;/span&gt;

            &lt;/div&gt;


            &lt;div&gt;

                &lt;strong&gt;
                    State / Province
                &lt;/strong&gt;

                &lt;span id="case-state"&gt;
                    —
                &lt;/span&gt;

            &lt;/div&gt;


            &lt;div&gt;

                &lt;strong&gt;
                    City
                &lt;/strong&gt;

                &lt;span id="case-city"&gt;
                    —
                &lt;/span&gt;

            &lt;/div&gt;


            &lt;div&gt;

                &lt;strong&gt;
                    Classification
                &lt;/strong&gt;

                &lt;span id="case-classification"&gt;
                    —
                &lt;/span&gt;

            &lt;/div&gt;

            &lt;div&gt;

                &lt;strong&gt;
                    Offense
                &lt;/strong&gt;

                &lt;span id="case-offense"&gt;
                    —
                &lt;/span&gt;

            &lt;/div&gt;


            &lt;div&gt;

                &lt;strong&gt;
                    Additional Offenses
                &lt;/strong&gt;

                &lt;span id="case-additional-offenses"&gt;
                    —
                &lt;/span&gt;

            &lt;/div&gt;



            &lt;div&gt;

                &lt;strong&gt;
                    Outcome
                &lt;/strong&gt;

                &lt;span id="case-outcome"&gt;
                    —
                &lt;/span&gt;

            &lt;/div&gt;


            &lt;div&gt;

                &lt;strong&gt;
                    Victim Count
                &lt;/strong&gt;

                &lt;span id="case-victims"&gt;
                    —
                &lt;/span&gt;

            &lt;/div&gt;


            &lt;div&gt;

                &lt;strong&gt;
                    Fatality Count
                &lt;/strong&gt;

                &lt;span id="case-fatalities"&gt;
                    —
                &lt;/span&gt;

            &lt;/div&gt;


        &lt;/div&gt;


        &lt;div class="case-description"&gt;

            &lt;h3&gt;
                Description
            &lt;/h3&gt;

            &lt;p id="case-description"&gt;
                —
            &lt;/p&gt;

        &lt;/div&gt;

    &lt;/section&gt;



    &lt;!-- =========================================
         PEOPLE INVOLVED
         ========================================= --&gt;

    &lt;section class="case-section"&gt;

        &lt;h2&gt;
            People Involved
        &lt;/h2&gt;

        &lt;div id="case-people"&gt;

            &lt;p class="empty-message"&gt;
                Loading people...
            &lt;/p&gt;

        &lt;/div&gt;

    &lt;/section&gt;



    &lt;!-- =========================================
        RESEARCH TAGS
        ========================================= --&gt;

    &lt;section class="case-section"&gt;

        &lt;h2&gt;
            Research Tags
        &lt;/h2&gt;

        &lt;!-- -----------------------------------------
             CRIME TAGS
             ----------------------------------------- --&gt;

        &lt;div class="case-tag-category"&gt;

            &lt;h3&gt;
                Crime Tags
            &lt;/h3&gt;

            &lt;p&gt;
                Crime characteristics, offenses, victim patterns, and other characteristics of the case.
            &lt;/p&gt;

            &lt;div id="case-crime-tags"&gt;

                &lt;p class="empty-message"&gt;
                    Loading crime tags...
                &lt;/p&gt;

            &lt;/div&gt;

        &lt;/div&gt;


        &lt;!-- -----------------------------------------
             INFLUENCE TAGS
             ----------------------------------------- --&gt;

        &lt;div class="case-tag-category"&gt;

            &lt;h3&gt;
                Influence Tags
            &lt;/h3&gt;

            &lt;p&gt;
                Documented factors or circumstances that may have influenced the behavior or events in the case.
            &lt;/p&gt;

            &lt;div id="case-influence-tags"&gt;

                &lt;p class="empty-message"&gt;
                    Loading influence tags...
                &lt;/p&gt;

            &lt;/div&gt;

        &lt;/div&gt;


        &lt;!-- -----------------------------------------
             MENTAL HEALTH TAGS
             ----------------------------------------- --&gt;

        &lt;div class="case-tag-category"&gt;

            &lt;h3&gt;
                Mental Health Tags
            &lt;/h3&gt;

            &lt;p&gt;
                Case-level mental-health factors supported by documented evidence. These tags do not represent an assumed diagnosis of an individual.
            &lt;/p&gt;

            &lt;div id="case-mental-health-tags"&gt;

                &lt;p class="empty-message"&gt;
                    Loading mental-health tags...
                &lt;/p&gt;

            &lt;/div&gt;

        &lt;/div&gt;

    &lt;/section&gt;



    &lt;!-- =========================================
         CRIME SCENE PHOTOS
         ========================================= --&gt;

    &lt;section class="case-section"&gt;

        &lt;h2&gt;
            Crime Scene Photos
        &lt;/h2&gt;

        &lt;div
            id="case-crime-scene-photos"
            class="crime-scene-grid"
        &gt;

            &lt;p class="empty-message"&gt;
                Loading crime scene photos...
            &lt;/p&gt;

        &lt;/div&gt;

    &lt;/section&gt;



    &lt;!-- =========================================
         MEDIA &amp; COVERAGE
         ========================================= --&gt;

    &lt;section class="case-section"&gt;

        &lt;h2&gt;
            Media &amp;amp; Coverage
        &lt;/h2&gt;

        &lt;p&gt;
            Videos, news coverage, interviews, documentaries, audio, and other media related to this case.
        &lt;/p&gt;


        &lt;div
            id="case-media"
            class="media-list"
        &gt;

            &lt;p class="empty-message"&gt;
                Loading media...
            &lt;/p&gt;

        &lt;/div&gt;

    &lt;/section&gt;



    &lt;!-- =========================================
         COURT RECORDS &amp; DOCUMENTS
         ========================================= --&gt;

    &lt;section class="case-section"&gt;

        &lt;h2&gt;
            Court Records &amp;amp; Documents
        &lt;/h2&gt;

        &lt;div
            id="case-documents"
            class="document-list"
        &gt;

            &lt;p class="empty-message"&gt;
                Loading documents...
            &lt;/p&gt;

        &lt;/div&gt;

    &lt;/section&gt;



    &lt;!-- =========================================
         SOURCES &amp; REFERENCES
         ========================================= --&gt;

    &lt;section class="case-section"&gt;

        &lt;h2&gt;
            Sources &amp;amp; References
        &lt;/h2&gt;

        &lt;div
            id="case-sources"
            class="source-list"
        &gt;

            &lt;p class="empty-message"&gt;
                Loading sources...
            &lt;/p&gt;

        &lt;/div&gt;

    &lt;/section&gt;



    &lt;!-- =========================================
         EXTERNAL LINKS
         ========================================= --&gt;

    &lt;section class="case-section"&gt;

        &lt;h2&gt;
            External Links
        &lt;/h2&gt;

        &lt;div
            id="case-links"
            class="external-link-list"
        &gt;

            &lt;p class="empty-message"&gt;
                Loading external links...
            &lt;/p&gt;

        &lt;/div&gt;

    &lt;/section&gt;



    &lt;!-- =========================================
         RELATED CASES
         ========================================= --&gt;

    &lt;section class="case-section"&gt;

        &lt;h2&gt;
            Related Cases
        &lt;/h2&gt;

        &lt;div
            id="case-related"
            class="related-case-list"
        &gt;

            &lt;p class="empty-message"&gt;
                Loading related cases...
            &lt;/p&gt;

        &lt;/div&gt;

    &lt;/section&gt;


&lt;/main&gt;



&lt;!-- =============================================
     FOOTER
     ============================================= --&gt;

&lt;footer&gt;

    &lt;p&gt;
        Criminal Behavior Research Archive
    &lt;/p&gt;

&lt;/footer&gt;



