5\"},{\"key\":\"expedia_business_agent\",\"label\":\"Expedia - Business Agent\"},{\"key\":\"expedia_prod_agent\",\"label\":\"Expedia Prod Agent\"},{\"key\":\"homh_prod_agent\",\"label\":\"Homh Prod Agent\"},{\"label\":\"Wayfair Prod Agent\",\"key\":\"wayfair_prod_agent\"},{\"key\":\"pottery_barn_prod_agent\",\"label\":\"Pottery Barn Prod Agent\"},{\"key\":\"shop_prod_agent\",\"label\":\"Shop Prod Agent\"},{\"label\":\"Answering Service Care Prod Agent\",\"key\":\"answering_service_prod_agent\"},{\"label\":\"Spellbook Prod Agent\",\"key\":\"spellbook_prod_agent\"},{\"label\":\"Booking.com Prod Agent\",\"key\":\"booking_prod_agent\"},{\"label\":\"Hilton Prod Agent\",\"key\":\"hilton_prod_agent\"},{\"key\":\"geico_test_agent\",\"label\":\"Geico Prod Agent\"},{\"key\":\"legalzoom_prod_agent\",\"label\":\"LegalZoom Prod Agent\"},{\"label\":\"The Feed Prod Agent\",\"key\":\"the_feed_prod_agent\"},{\"key\":\"brilliant_earth_prod_agent\",\"label\":\"Brilliant Earth Prod Agent\"},{\"label\":\"Angi Prod Agent\",\"key\":\"angi_prod_agent\"},{\"label\":\"Shopify SMB Prod Agent\",\"key\":\"shopify_smb_prod_agent\"},{\"key\":\"canva_print_prod_agent\",\"label\":\"Canva Print Prod Agent\"},{\"key\":\"budget_direct_prod_agent\",\"label\":\"Budget Direct Prod Agent\"},{\"label\":\"Lowes Prod Agent\",\"key\":\"lowes_prod_agent\"},{\"label\":\"Personalized: Composer Pinned (Server)\",\"key\":\"image_card_v2_personalized_ads_mvp_2_composer_pinned\"}]},\"is_device_based\":false,\"passed\":false},\"3961845717\":{\"name\":\"3961845717\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{\"styles\":[\"cyberpunk\",\"anime\",\"dramatic-headshot\",\"coloring-book\",\"photo-shoot\",\"retro-cartoon\",\"80s-glam\",\"art-nouveau\",\"synthwave\"]},\"is_device_based\":false,\"passed\":false},\"1001765573\":{\"name\":\"1001765573\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"4113286138\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1829150232\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":1043,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"1717390098\":{\"name\":\"1717390098\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"2898025270\",\"gateValue\":\"false\",\"ruleID\":\"7342L0RKNFaahun8rgEWIe\"}],\"version\":14,\"id_type\":\"userID\",\"value\":{\"work\":false,\"chat\":false},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"user_prompt_key\":\"good_option\",\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"enable_web_search\":false},\"is_device_based\":false,\"passed\":false},\"1800637375\":{\"name\":\"1800637375\",\"rule_id\":\"1t8E34IgQR6ODV93aC9Ley\",\"secondary_exposures\":[],\"version\":10,\"id_type\":\"userID\",\"value\":{\"enabled\":false},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"enabled\"],\"group_name\":\"Control\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"541754464\":{\"name\":\"541754464\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":10,\"id_type\":\"userID\",\"value\":{\"enabled\":true,\"view\":\"onboarding_v3\"},\"is_device_based\":false,\"passed\":false},\"216497991\":{\"name\":\"216497991\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":16,\"id_type\":\"userID\",\"value\":{\"max_pinned_room_count\":2,\"outdated_room_bootstrap_messages_count\":10,\"max_file_size_mb\":5,\"idle_room_navigation_timeout_s\":900,\"typing_indicator_timeout_s\":10,\"sidebar_pagination_page_size\":6,\"sidebar_default_recent_room_row_count\":3},\"is_device_based\":false,\"passed\":false},\"1341269548\":{\"name\":\"1341269548\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"295757309\",\"gateValue\":\"false\",\"ruleID\":\"6CYqzLNR69kOtn13xAfiry\"}],\"version\":19,\"id_type\":\"userID\",\"value\":{\"enabled\":true,\"kind\":\"social\",\"tempDisabled\":false,\"loginStrategy\":\"existing_user\",\"name\":\"google\"},\"is_device_based\":false,\"passed\":false},\"765440106\":{\"name\":\"765440106\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":13,\"id_type\":\"userID\",\"value\":{\"customer_balance_cache\":{\"write_timeout_ms\":500,\"read_timeout_ms\":500,\"enabled\":false},\"cross_currency_wallet_warning\":{\"timeout_ms\":3000,\"enabled\":true},\"wallet_oaics_minimum_balance_minor_units\":0},\"is_device