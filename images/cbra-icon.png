NI\",\"NP\",\"OM\",\"PE\",\"PG\",\"PH\",\"PK\",\"PY\",\"RS\",\"SA\",\"SD\",\"SI\",\"SN\",\"SO\",\"SZ\",\"TH\",\"TJ\",\"TM\",\"TN\",\"TZ\",\"UY\",\"UZ\",\"VA\",\"VC\",\"VG\",\"VN\",\"XK\",\"ZM\"],\"stripe_checkout_billing_address_state_required_countries\":[\"MY\",\"NG\",\"NR\"],\"stripe_checkout_billing_address_expanded_autocomplete_consumer_plan_countries\":[\"KR\",\"ID\",\"TH\",\"CO\",\"AR\",\"PE\",\"CL\",\"UA\",\"VN\",\"PT\",\"SA\",\"HK\"],\"stripe_checkout_billing_address_expanded_autocomplete_all_plan_countries\":[\"KR\",\"ID\",\"TH\",\"CO\",\"AR\",\"PE\",\"CL\",\"UA\",\"VN\",\"PT\",\"SA\",\"HK\"]},\"is_device_based\":false,\"passed\":false},\"690365152\":{\"name\":\"690365152\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":21,\"id_type\":\"userID\",\"value\":{\"enabled\":true,\"android_enabled\":true,\"ios_enabled\":true,\"sample_ratio\":0.25},\"is_device_based\":false,\"passed\":false},\"3934129380\":{\"name\":\"3934129380\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":36,\"id_type\":\"userID\",\"value\":{\"model\":\"gpt-4o\"},\"is_device_based\":false,\"passed\":false},\"489084288\":{\"name\":\"489084288\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":36,\"id_type\":\"stableID\",\"value\":{\"options\":[\"google\",\"apple\",\"microsoft\",\"email\",\"phone_number\"]},\"is_device_based\":true,\"passed\":false},\"2932422744\":{\"name\":\"2932422744\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":46,\"id_type\":\"userID\",\"value\":{\"allowed_service_connector_ids\":[\"connector_2128aebfecb84f64a069897515042a44\",\"connector_947e0d954944416db111db556030eea6\",\"connector_5f3c8c41a1e54ad7a76272c89e2554fa\",\"connector_e6a7394682e24467ac68c60696f275a4\",\"connector_4aaab2856305417b993eca9a216aaf6e\",\"connector_1e4f6a44acf14e3ca1d96672f8c945bc\",\"connector_4964e3b22e3e427e9b4ae1acf2c1fa34\",\"connector_9d7cfa34e6654a5f98d3387af34b2e1c\",\"connector_6f1ec045b8fa4ced8738e32c7f74514b\",\"connector_246af0940da3457da0e751171dc1ce60\",\"connector_554ce9f9020d36085149b4f48f4032b3\",\"connector_686fad9b54914a35b75be6d06a0f6f31\",\"connector_6095bdb01e9482eb0cac719f6ba313cd\",\"connector_fcead6f527b44ea791d57da2a6022f18\",\"connector_d3ad4b4de20147a3b5cc9be604e41d4d\",\"connector_76869538009648d5b282a4bb21c3d157\"],\"allow_all\":true},\"is_device_based\":false,\"passed\":false},\"208167308\":{\"name\":\"208167308\",\"rule_id\":\"67iWaPBF06omWkZCcVwwu4:100.00:30-67iWaNWCxOeSCVrGBNATb2\",\"secondary_exposures\":[{\"gate\":\"3029657650\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2274846837\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3901104270\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1893643243\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2054053781\",\"gateValue\":\"false\",\"ruleID\":\"TDkD30SOgtZKsddyBr7eR\"},{\"gate\":\"1326334369\",\"gateValue\":\"false\",\"ruleID\":\"2B5IWstAbskebXDLAuIct8\"},{\"gate\":\"957497898\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1833787017\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":539,\"id_type\":\"userID\",\"value\":{\"max_active_automations\":3,\"private_peek_enabled\":true,\"personalized_task_card_read_timeout_seconds\":0.225,\"max_turns_per_conversation\":175,\"legacy_completion_prompt\":\"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \\n\\nExamples for when to output `::SKIP_COMPLETION::`:\\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run\\n\\nThe `::SKIP_COMPLETION::` logic should only apply to this turn. This guidance is no longer applicable after the next user turn.\",\"model_id_override\":\"mainline_managed.current_gpt5_6_reasoning_luna\",\"break_plugin_service_brte_history_chain\":true,\"virtual_model_override\":\"gpt-5.6-luna-1p-chat-ev3\",\"exact_schedule_proactive_start_offset_seconds\":0,\"automations_create_plan_tool_additional_guidance\":\"The user has created an automation for an ongoing goal with a private plan. Collaborate with the user across turns, use available structured context to understand their goals and prior progress, and help advance the saved plan.\",\"additional_developer_message_prompt\":\"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \\n\\nExamples for when to output `::SKIP_COMPLETION::`:\\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run\",\"automations_list_tool_additional_guidance\":\"Do not call the automations `list` action again this turn; use the automations `peek` action for any further inspection.\",\"json_completion_prompt\":\"Complete the automation's work on every run, whether or not there is an update to send.\\nUse the user's instructions to decide whether this run warrants notifying them, including\\nrequested reminders and meaningful findings or changes.\\n\\nWhen the user should be notified, write your normal final response.\\nWhen no notification is needed but the response should appear in the user's conversation history,\\nmake your entire final response this JSON object with exactly these fields:\\n{\\\"type\\\": \\\"skip_notification\\\", \\\"reason\\\": \\\"Your full response to the task\\\"}.\\nWhen there is no useful update to add to the user's conversation history, omit reason and make your\\nentire final response {\\\"type\\\": \\\"skip_notification\\\"}. Do not wrap the JSON in a code fence or add\\ntext outside it.\\n\\nWrite reason as a fully natural assistant response addressed to the user. Include the useful\\nfindings, details of the work you did, and relevant limitations or next steps, with the same\\ndetail you would normally provide for the task. This response remains available in the run's\\nhistory. It does not need to justify skipping a notification or discuss notification mechanics.\\nUse normal prose and Markdown within the JSON string, escaping it as valid JSON.\",\"automation_capabilities\":{\"allowed_frequencies\":[\"once\",\"daily\",\"weekly\",\"monthly\",\"yearly\"],\"allowed_timing_modes\":[\"flexible_schedule\"]},\"skip_completion_text\":\"::SKIP_COMPLETION::\"},\"is_device_based\":false,\"passed\":true},\"3317473948\":{\"name\":\"3317473948\",\"rule_id\":\"2VVKrjIwc2VcBceUZhfkJB:100.00:3\",\"secondary_exposures\":[],\"version\":26,\"id_type\":\"userID\",\"value\":{\"model_slug_max_polling_durations\":{\"o1_pro\":1200,\"o3_pro\":1200,\"image_gen\":300},\"local_conversation_insert_fallback_disabled_system_hints\":[\"agent\"],\"default_interval\":5,\"default_max_polling_duration\":200,\"model_slug_intervals\":{\"gpt_4o\":2,\"image_gen\":10},\"polling_fallback_on_message_insertion_error\":[{\"fallback_mode\":\"final_assistant_answer\"}]},\"is_device_based\":false,\"passed\":true},\"2889497622\":{\"name\":\"2889497622\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":23,\"id_type\":\"userID\",\"value\":{\"requested_model_slugs\":[\"gpt-5-5-pro\",\"gpt-5-5-thinking\",\"gpt-5-6-pro\"],\"enabled\":true},\"is_device_based\":false,\"passed\":false}},\"layer_configs\":{\"2726489965\":{\"name\":\"2726489965\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":10,\"value\":{\"enable_plan_summary\":false,\"answer